DATABASE_URL=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000


# --- College database (all optional unless noted) ---
# Comma-separated emails allowed to use /admin to review and verify catalog data.
ADMIN_EMAILS=
# Local embedded Postgres for scripts/tests instead of DATABASE_URL (e.g. ./.local-db/atlas).
ATLAS_PGLITE_DIR=
# Override the current application cycle (defaults to the Aug 1 boundary, e.g. 2026-2027).
APPLICATION_CYCLE=
# Free api.data.gov key, only needed for `catalog:import-directory -- --scorecard-api`.
DATA_GOV_API_KEY=
# Contact URL/email included in the crawler User-Agent when fetching official admissions pages.
ATLAS_CRAWLER_CONTACT=
# Scheduled refresh of registered official pages (/api/cron/admissions-refresh). Off by default.
ADMISSIONS_REFRESH_ENABLED=false
ADMISSIONS_REFRESH_MAX_SOURCES=25
CRON_SECRET=
# Optional AI-assisted extraction model (uses OPENAI_API_KEY); results are still validated verbatim.
ADMISSIONS_EXTRACTION_MODEL=

# --- AI provider (any OpenAI-compatible server: OpenAI, or a local one like oMLX) ---
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_STUDIO_MODEL=
OPENAI_STORYLINES_MODEL=
# Per-student daily AI request cap, and how long to wait for one AI answer.
AI_DAILY_REQUEST_LIMIT=40
AI_REQUEST_TIMEOUT_MS=90000

# --- Claude (Anthropic) provider ---
# AI_PROVIDER=claude uses Claude; AI_PROVIDER=openai uses the OPENAI_* settings above.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (more effort = deeper reasoning, more tokens).
ANTHROPIC_EFFORT=medium
