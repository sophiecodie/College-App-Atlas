{"prompt_id": "duke-01", "college_name": "Duke", "college_slug": "duke", "cycle": "2026-2027", "prompt_text": "What is your impression of Duke as a university and community, and why do you believe it is a good match for your goals, values, and interests? If there is something specific that attracts you to our academic offerings in Trinity College of Arts and Sciences or the Pratt School of Engineering, or to our co-curricular opportunities, feel free to include that, too.", "word_limit": 250, "required": true, "prompt_type": "supplemental_essay", "source_url": "https://admissions.duke.edu/apply/", "source_type": "webpage", "extraction_status": "confirmed", "last_updated": "2026-03-20T02:05:35Z", "primary_tag": "Why Us", "secondary_tags": []}
